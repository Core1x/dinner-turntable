{
  "name": "dinner-wheel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9",
    "vue-tsc": "^3.1.4",
    "wrangler": "^4.47.0"
  }
}
